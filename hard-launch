<style>

@font-face {
  font-family: 'CasualHandwriting';
  src:
    url('CasualHandwriting.woff2') format('woff2'),
    url('CasualHandwriting.woff') format('woff');
  font-weight: normal;
  font-style: normal;
  font-display: swap;
}

:root {
  --ink: #132447;
  --navy: #132447;
  --paper: #ffffff;
  --stone: #DEDAD1;
  --slate: #596674;
  --yellow: #fcd346;
  --brass: #e6b800;
  --f-accent: 'CasualHandwriting', cursive;
  --f-head: 'Montserrat', sans-serif;
  --f-body: 'Montserrat', sans-serif;
  --max: 1120px;
  --gutter: clamp(24px, 5vw, 80px);
  --section-gap: clamp(58px, 7vw, 88px);
  --nav-height: 72px;
}

*,
*::before,
*::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--nav-height) + 20px);
}

html,
body {
  background: var(--paper);
}

body {
  color: var(--ink);
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.7;
  -webkit-font-smoothing: antialiased;
  overflow-x: hidden;
}

img {
  display: block;
  max-width: 100%;
  height: auto;
}

a {
  color: inherit;
  text-decoration: none;
}

ul,
ol {
  list-style: none;
}

button,
input,
textarea {
  font: inherit;
}

.container {
  width: 100%;
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 var(--gutter);
}

/* ACCESSIBILITY */

.skip-link {
  position: fixed;
  top: 8px;
  left: 12px;
  z-index: 9999;
  padding: 12px 18px;
  background: var(--yellow);
  color: var(--navy);
  font-size: 14px;
  font-weight: 700;
  transform: translateY(-160%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: translateY(0);
}

a:focus-visible,
button:focus-visible,
input:focus-visible,
textarea:focus-visible {
  outline: 3px solid var(--yellow);
  outline-offset: 3px;
}

/* NAV — matched to current pricing page */

.nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: var(--navy);
  transition: box-shadow 0.3s ease;
}

.nav::after {
  content: "";
  position: absolute;
  top: 100%;
  left: 0;
  right: 0;
  height: 4px;
  background: var(--navy);
}

.nav.scrolled {
  box-shadow: 0 2px 24px rgba(19,36,71,0.38);
}

.nav-inner {
  max-width: var(--max);
  height: var(--nav-height);
  margin: 0 auto;
  padding: 0 var(--gutter);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.nav-logo {
  width: 52px;
  height: 52px;
  min-width: 52px;
  min-height: 52px;
  flex: 0 0 52px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-logo img {
  width: 52px;
  height: 52px;
  max-width: none;
  aspect-ratio: 1 / 1;
  object-fit: contain;
  flex-shrink: 0;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 22px;
  flex-wrap: nowrap;
}

.nav-links a {
  min-height: 44px;
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  font-weight: 500;
  color: rgba(255,255,255,0.78);
  letter-spacing: 0.03em;
  white-space: nowrap;
}

.nav-links a:hover {
  color: var(--paper);
}

.nav-cta {
  min-height: 44px !important;
  padding: 10px 18px;
  background: var(--yellow) !important;
  color: var(--navy) !important;
  font-weight: 700 !important;
}

.nav-cta:hover {
  background: var(--brass) !important;
}

.nav-toggle {
  width: 44px;
  height: 44px;
  display: none;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  gap: 5px;
  cursor: pointer;
  background: none;
  border: none;
}

.nav-toggle span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--paper);
}

.cta-short {
  display: none;
}

/* HERO */

.match-hero {
  margin-top: var(--nav-height);
  padding: clamp(56px, 7vw, 88px) 0;
  background: var(--navy);
  color: var(--paper);
  border-bottom: 1px solid rgba(255,255,255,0.12);
}

.match-hero-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(310px, 0.72fr);
  gap: clamp(44px, 7vw, 88px);
  align-items: center;
}

.eyebrow-label {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 28px;
}

.eyebrow-tag {
  flex-shrink: 0;
  padding: 6px 13px;
  background: var(--yellow);
  color: var(--navy);
  font-size: 11px;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

.eyebrow-desc {
  font-size: 11px;
  font-weight: 600;
  line-height: 1.4;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.68);
}

.match-hero h1 {
  max-width: 710px;
  font-family: var(--f-head);
  font-size: clamp(48px, 7vw, 86px);
  font-weight: 500;
  line-height: 0.98;
  letter-spacing: -0.055em;
  color: var(--paper);
}

.match-hero h1 span {
  display: block;
  margin-top: 8px;
  color: var(--yellow);
}

.hero-copy {
  max-width: 650px;
  margin-top: 26px;
  font-size: clamp(16px, 1.7vw, 19px);
  line-height: 1.76;
  color: rgba(255,255,255,0.82);
}

.hero-copy strong {
  color: var(--paper);
  font-weight: 600;
}

.hero-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 30px;
}

.btn-yellow,
.btn-outline,
.btn-navy {
  min-height: 46px;
  padding: 13px 23px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.btn-yellow {
  background: var(--yellow);
  color: var(--navy);
}

.btn-yellow:hover {
  background: var(--brass);
}

.btn-outline {
  border: 1px solid rgba(255,255,255,0.42);
  color: var(--paper);
}

.btn-outline:hover {
  border-color: var(--paper);
}

.btn-navy {
  background: var(--navy);
  color: var(--paper);
}

.btn-navy:hover {
  background: var(--slate);
}

/* HERO VALUE PANEL */

.match-math {
  position: relative;
  padding: clamp(28px, 4vw, 42px);
  background: var(--yellow);
  color: var(--navy);
}

.match-math::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(19,36,71,0.22);
  pointer-events: none;
}

.math-kicker {
  display: block;
  position: relative;
  z-index: 1;
  margin-bottom: 16px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.18em;
  text-transform: uppercase;
}

.math-big {
  position: relative;
  z-index: 1;
  font-family: var(--f-head);
  font-size: clamp(33px, 4vw, 49px);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -0.04em;
}

.math-plus {
  display: block;
  margin: 10px 0;
  font-family: var(--f-accent);
  font-size: 38px;
  line-height: 1;
}

.math-result {
  position: relative;
  z-index: 1;
  margin-top: 20px;
  padding-top: 18px;
  border-top: 1px solid rgba(19,36,71,0.28);
  font-size: 15px;
  line-height: 1.65;
}

.math-result strong {
  font-size: 20px;
}

/* SHARED */

.section {
  padding: var(--section-gap) 0;
}

.section-label {
  display: block;
  margin-bottom: 13px;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--slate);
}

.section h2 {
  max-width: 780px;
  font-family: var(--f-head);
  font-size: clamp(29px, 4vw, 44px);
  font-weight: 400;
  line-height: 1.15;
  letter-spacing: -0.03em;
  color: var(--ink);
}

.section-intro {
  max-width: 720px;
  margin-top: 18px;
  font-size: 16px;
  line-height: 1.82;
  color: var(--slate);
}

.script-accent {
  display: block;
  margin-top: 4px;
  font-family: var(--f-accent);
  font-size: clamp(34px, 4.7vw, 50px);
  font-weight: normal;
  line-height: 1.15;
  letter-spacing: 0.025em;
  word-spacing: 0.08em;
  color: var(--navy);
}

/* WHY */

.why-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: clamp(44px, 7vw, 84px);
  align-items: start;
}

.why-copy {
  padding-left: clamp(22px, 3vw, 32px);
  border-left: 3px solid var(--yellow);
}

.why-copy p {
  margin-bottom: 16px;
  font-size: 16px;
  line-height: 1.82;
  color: var(--ink);
}

.why-copy p:last-child {
  margin-bottom: 0;
}

/* WHAT IT CAN COVER */

.cover-section {
  background: var(--navy);
  color: var(--paper);
}

.cover-section .section-label {
  color: var(--yellow);
}

.cover-section h2 {
  color: var(--paper);
}

.cover-section .section-intro {
  color: rgba(255,255,255,0.76);
}

.cover-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  margin-top: clamp(34px, 5vw, 50px);
  border-top: 1px solid rgba(255,255,255,0.16);
}

.cover-item {
  padding: 20px 0;
  border-bottom: 1px solid rgba(255,255,255,0.14);
}

.cover-item:nth-child(odd) {
  padding-right: clamp(20px, 4vw, 50px);
}

.cover-item:nth-child(even) {
  padding-left: clamp(20px, 4vw, 50px);
  border-left: 1px solid rgba(255,255,255,0.14);
}

.cover-item h3 {
  margin-bottom: 5px;
  font-size: 16px;
  font-weight: 600;
  color: var(--yellow);
}

.cover-item p {
  font-size: 14px;
  line-height: 1.7;
  color: rgba(255,255,255,0.76);
}

.cover-note {
  max-width: 760px;
  margin-top: 30px;
  font-size: 15px;
  line-height: 1.78;
  color: rgba(255,255,255,0.8);
}

/* EXAMPLES */

.example-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: clamp(34px, 5vw, 48px);
  border-top: 1px solid var(--stone);
  border-bottom: 1px solid var(--stone);
}

.example-card {
  min-width: 0;
  padding: clamp(28px, 3vw, 36px);
  border-right: 1px solid var(--stone);
}

.example-card:first-child {
  border-left: 1px solid var(--stone);
}

.example-tag {
  display: inline-block;
  margin-bottom: 16px;
  padding: 5px 9px;
  background: var(--yellow);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.example-card h3 {
  margin-bottom: 18px;
  font-family: var(--f-head);
  font-size: clamp(20px, 2.2vw, 26px);
  font-weight: 500;
  line-height: 1.25;
  letter-spacing: -0.025em;
}

.example-row {
  padding: 13px 0;
  border-top: 1px solid var(--stone);
}

.example-row strong {
  display: block;
  margin-bottom: 3px;
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.example-row p {
  font-size: 14px;
  line-height: 1.68;
  color: var(--slate);
}

.example-total {
  margin-top: 18px;
  font-size: 15px;
  font-weight: 600;
}

/* PROCESS */

.process-section {
  background: var(--yellow);
}

.process-section .section-label {
  color: rgba(19,36,71,0.72);
}

.process-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: clamp(26px, 4vw, 50px);
  margin-top: 38px;
}

.process-step {
  padding-top: 18px;
  border-top: 1px solid rgba(19,36,71,0.26);
}

.process-number {
  margin-bottom: 12px;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.15em;
}

.process-step h3 {
  margin-bottom: 10px;
  font-size: 20px;
  font-weight: 600;
  line-height: 1.3;
}

.process-step p {
  font-size: 14px;
  line-height: 1.72;
}

/* TERMS */

.terms-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
  gap: clamp(42px, 7vw, 84px);
}

.terms-list {
  border-top: 1px solid var(--stone);
}

.terms-list li {
  position: relative;
  padding: 15px 0 15px 22px;
  border-bottom: 1px solid var(--stone);
  font-size: 14px;
  line-height: 1.72;
  color: var(--slate);
}

.terms-list li::before {
  content: "";
  position: absolute;
  top: 25px;
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--yellow);
}

/* CTA / FORM */

.cta-section {
  padding: var(--section-gap) 0;
  background: var(--navy);
  color: var(--paper);
}

.cta-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  gap: clamp(44px, 7vw, 84px);
  align-items: start;
}

.cta-section .section-label {
  color: var(--yellow);
}

.cta-section h2 {
  max-width: 520px;
  color: var(--paper);
}

.cta-copy {
  max-width: 500px;
  margin-top: 18px;
  color: rgba(255,255,255,0.76);
  font-size: 15px;
  line-height: 1.82;
}

.form-heading-note {
  margin-top: 18px;
  font-family: var(--f-accent);
  font-size: 30px;
  line-height: 1.2;
  color: var(--yellow);
}

.contact-form {
  display: grid;
  gap: 17px;
}

.form-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 17px;
}

.form-field label {
  display: block;
  margin-bottom: 7px;
  font-size: 12px;
  font-weight: 600;
  color: rgba(255,255,255,0.82);
}

.optional {
  font-weight: 400;
  color: rgba(255,255,255,0.48);
}

.form-field input,
.form-field textarea {
  width: 100%;
  min-height: 48px;
  padding: 13px 14px;
  border: 1px solid rgba(255,255,255,0.25);
  border-radius: 0;
  background: rgba(255,255,255,0.06);
  color: var(--paper);
}

.form-field textarea {
  min-height: 145px;
  resize: vertical;
}

.form-field input::placeholder,
.form-field textarea::placeholder {
  color: rgba(255,255,255,0.42);
}

.form-status {
  min-height: 22px;
  font-size: 13px;
  color: rgba(255,255,255,0.75);
}

.form-status.error {
  color: #ffd1c2;
}

/* STREET */

.street-scene {
  width: 100%;
  line-height: 0;
  background: var(--paper);
  overflow: hidden;
}

.street-scene img {
  width: 100%;
  max-height: 300px;
  object-fit: cover;
  object-position: center;
}

/* FOOTER — matched to current pricing page */

.footer {
  padding: 48px 0 32px;
  background: var(--paper);
  border-top: 1px solid var(--stone);
}

.footer-inner {
  max-width: var(--max);
  margin: 0 auto;
  padding: 0 var(--gutter);
  text-align: center;
}

.footer-logo-wrap {
  margin-bottom: 16px;
}

.footer-logo-wrap img {
  width: 96px;
  height: 96px;
  margin: 0 auto;
  object-fit: contain;
}

.footer-tagline {
  max-width: 460px;
  margin: 0 auto 28px;
  font-size: 13px;
  line-height: 1.7;
  color: var(--slate);
}

.footer-divider {
  margin-bottom: 24px;
  border: none;
  border-top: 1px solid var(--stone);
}

.footer-nav {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 26px;
  margin-bottom: 28px;
}

.footer-nav a {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  font-size: 13px;
  color: var(--slate);
}

.footer-nav a:hover {
  color: var(--ink);
}

.footer-bottom {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  flex-wrap: wrap;
}

.footer-copy {
  font-size: 12px;
  letter-spacing: 0.03em;
  color: var(--slate);
}

.footer-dot-sm {
  width: 6px;
  height: 6px;
  flex-shrink: 0;
  border-radius: 50%;
  background: var(--yellow);
}

.footer-legal-links {
  display: flex;
  justify-content: center;
  gap: 20px;
  margin-top: 16px;
}

.footer-legal-links a {
  min-height: 40px;
  display: inline-flex;
  align-items: center;
  font-size: 12px;
  color: var(--slate);
  text-decoration: underline;
  text-underline-offset: 3px;
}

/* RESPONSIVE */

@media (max-width: 960px) {

  .match-hero-grid,
  .why-grid,
  .terms-grid,
  .cta-grid {
    grid-template-columns: 1fr;
  }

  .match-math {
    max-width: 560px;
  }

  .example-grid {
    grid-template-columns: 1fr;
  }

  .example-card,
  .example-card:first-child {
    border-left: 1px solid var(--stone);
    border-right: 1px solid var(--stone);
    border-bottom: 1px solid var(--stone);
  }

  .example-card:last-child {
    border-bottom: none;
  }

}

@media (max-width: 900px) {

  .nav-links {
    display: none;
  }

  .nav-links.open {
    position: fixed;
    top: var(--nav-height);
    left: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    max-height: calc(100vh - var(--nav-height));
    overflow-y: auto;
    padding: 18px var(--gutter) 28px;
    background: var(--navy);
    gap: 3px;
    border-top: 1px solid rgba(255,255,255,0.08);
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .nav-links.open a {
    min-height: 48px;
  }

  .nav-toggle {
    display: flex;
  }

}

@media (max-width: 700px) {

  .cover-grid {
    grid-template-columns: 1fr;
  }

  .cover-item:nth-child(odd),
  .cover-item:nth-child(even) {
    padding-left: 0;
    padding-right: 0;
    border-left: none;
  }

  .process-grid {
    grid-template-columns: 1fr;
  }

  .form-row {
    grid-template-columns: 1fr;
  }

}

@media (max-width: 640px) {

  .eyebrow-label {
